{
  "expo": {
    "name": "Project Alpha",
    "slug": "project-alpha",
    "scheme": "projectalpha",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ragnaldocode.projectalpha"
    },
    "android": {
      "package": "com.ragnaldocode.projectalpha",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para importar o tabuleiro de Sudoku.",
          "cameraPermission": "A câmera é usada para fotografar o tabuleiro de Sudoku.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
